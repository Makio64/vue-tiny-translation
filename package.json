{
  "name": "vue-tiny-translation",
  "version": "1.1.0",
  "description": "A minimalist reactive translation plugin for Vue 3. Super lightweight (0.35KB gzipped).",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c && cp src/index.d.ts dist/index.d.ts",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "i18n",
    "translation",
    "internationalization",
    "reactive",
    "plugin",
    "tiny",
    "minimalist"
  ],
  "author": "Makio64 | David Ronai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Makio64/vue-tiny-translation.git"
  },
  "bugs": {
    "url": "https://github.com/Makio64/vue-tiny-translation/issues"
  },
  "homepage": "https://github.com/Makio64/vue-tiny-translation#readme",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.45.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.13.1"
}