{
  "name": "vue-tiny-translation",
  "version": "1.1.0",
  "description": "A minimalist reactive translation plugin for Vue 3. Super lightweight (0.35KB gzipped).",
  "type": "module",
  "module": "dist/index.esm.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.esm.js",
      "production": "./dist/index.esm.min.js",
      "import": "./dist/index.esm.min.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c && cp src/index.d.ts dist/index.d.ts",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "i18n",
    "translation",
    "internationalization",
    "localization",
    "l10n",
    "reactive",
    "plugin",
    "tiny",
    "lightweight",
    "minimalist",
    "vite",
    "nuxt"
  ],
  "author": "Makio64 | David Ronai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Makio64/vue-tiny-translation.git"
  },
  "bugs": {
    "url": "https://github.com/Makio64/vue-tiny-translation/issues"
  },
  "homepage": "https://github.com/Makio64/vue-tiny-translation#readme",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.60.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0"
}